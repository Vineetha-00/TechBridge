# ====================================================================
# TechBridge Environment Variables Template
# ====================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# External AI Service (Google Gemini API / OpenAI compatible)
# Obtain free API key: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-1.5-flash

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
